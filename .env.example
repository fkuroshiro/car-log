# Copy to .env and fill in. .env is gitignored — never commit real values.

# App (bundled into the client — safe to expose, protected by RLS):
# Supabase dashboard → Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# CLI only (secrets — no EXPO_PUBLIC_ prefix, so never bundled into the app):
# Access token: dashboard avatar menu → Account Settings → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# The database password you chose when creating the project
SUPABASE_DB_PASSWORD=...

# TEMPORARY until the auth phase: dev account the app signs into
# automatically in development builds. Remove once real auth screens exist.
EXPO_PUBLIC_DEV_EMAIL=...
EXPO_PUBLIC_DEV_PASSWORD=...
